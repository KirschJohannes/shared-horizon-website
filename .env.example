# Bereits für die Website-Anfrage-Route (app/api/anfrage) in Vercel gesetzt —
# die Vertrags-App (/vertrag) nutzt dieselben SMTP-Zugangsdaten mit, kein
# zusätzliches Konto nötig.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Neu für die Vertrags-App: schützen /vertrag/neu per HTTP Basic Auth.
NEU_BASIC_AUTH_USER=
NEU_BASIC_AUTH_PASSWORD=
